{
	auto_https off
}

:80 {
	handle /__gateway/health {
		respond "ok" 200
	}

	# Laravel route inventory and browser-observed Filament assets establish these families.
	@laravel path /api /api/* /admin /admin/* /up /storage/* /filament /filament/* /css/filament/* /fonts/filament/* /js/filament/* /cv/*
	handle @laravel {
		reverse_proxy api:80
	}

	# Livewire's installed prefix is content-addressed and changes with its package build.
	# Match the family structurally; never copy the generated prefix from the route inventory.
	@livewire path_regexp livewire ^/livewire-[^/]+(?:/.*)?$
	handle @livewire {
		reverse_proxy api:80
	}

	# This final handler owns the Vite front (/, /es, /en), its assets, and development HMR/WebSocket traffic.
	handle {
		reverse_proxy web:5173
	}
}
